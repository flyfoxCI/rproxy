# Copy to .env; use independent random values. Never commit .env.
# Generate with `openssl rand -hex 32`, or a password manager.
# Entry password is one-time TOML bootstrap only; later use rproxy-cli user passwd.
RPROXY_PASSWORD=
RPROXY_ADMIN_TOKEN=
# Proxy ports are local-only unless explicitly changed. Management is not published.
RPROXY_BIND_ADDRESS=127.0.0.1
RPROXY_HTTP_PORT=9099
RPROXY_SOCKS5_PORT=9089
RPROXY_HTTPS_PORT=9443
# Optional host paths, relative to compose.yaml (absolute paths also work).
# RPROXY_CONFIG=./rproxy.toml
# RPROXY_PROVIDERS_ENV=./providers.env
# RPROXY_CERTS_DIR=./certs

# Copy to .env and fill three DIFFERENT random values for first startup. Never commit .env.
# Generate separate random values: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Entry password: one-time TOML bootstrap only. Later use rproxy-cli user passwd.
RPROXY_PASSWORD=
# Root administration and limited collector access must use different tokens.
RPROXY_ADMIN_TOKEN=
RPROXY_WORKER_TOKEN=
# Proxy ports are local-only unless explicitly changed. Management is never published.
RPROXY_BIND_ADDRESS=127.0.0.1
RPROXY_HTTP_PORT=9099
RPROXY_SOCKS5_PORT=9089
RPROXY_HTTPS_PORT=9443
# Optional host paths, relative to compose.yaml (absolute paths also work).
# RPROXY_CONFIG=./rproxy.toml
# RPROXY_COLLECTOR_CONFIG=./scripts/proxy.toml
# RPROXY_PROVIDERS_ENV=./scripts/providers.env
# RPROXY_CERTS_DIR=./certs

# Copy to providers.env; add ONLY variables referenced by your enabled sources.
# Read as UTF-8 KEY=VALUE by rproxy's internal collector, not executed as shell.
# SUPPLIER_API_URL=https://your-provider.example/extract
# SUPPLIER_API_TOKEN=replace-with-your-secret
# XDAILI_API_URL=your-account-extraction-url
# SHENLONG_API_URL=your-account-extraction-url
# Never include RPROXY_ADMIN_TOKEN, RPROXY_SOURCE_KEY or entry passwords.
